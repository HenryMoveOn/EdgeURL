<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>Edge URL</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Edge URL</string>
			<key>footerText</key>
			<string>A swipe in from the left or right edge of the screen opens this URL. Leave it empty to turn opening off.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enable Edge URL</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>URL</string>
			<key>key</key>
			<string>URL</string>
			<key>default</key>
			<string></string>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
			<key>placeholder</key>
			<string>https://example.com</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Trigger Area</string>
			<key>footerText</key>
			<string>Which edges answer, how far in the swipe may start, and which part of the screen height reacts.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Left Edge</string>
			<key>key</key>
			<string>LeftEdge</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Right Edge</string>
			<key>key</key>
			<string>RightEdge</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Edge Width</string>
			<key>key</key>
			<string>EdgeWidth</string>
			<key>default</key>
			<integer>32</integer>
			<key>min</key>
			<integer>10</integer>
			<key>max</key>
			<integer>80</integer>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Region Top (%)</string>
			<key>key</key>
			<string>RegionTop</string>
			<key>default</key>
			<integer>0</integer>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>90</integer>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Region Height (%)</string>
			<key>key</key>
			<string>RegionHeight</string>
			<key>default</key>
			<integer>100</integer>
			<key>min</key>
			<integer>10</integer>
			<key>max</key>
			<integer>100</integer>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Show Trigger Area</string>
			<key>key</key>
			<string>ShowArea</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
			<key>footerText</key>
			<string>Draws the band while the desktop is showing, so the trigger area can be seen and hit. Off hides it whatever Area Opacity is set to.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Area Opacity</string>
			<key>footerText</key>
			<string>The slider sets the trigger band's opacity itself: 0 leaves the band invisible, 1 tints it solid, 0.2 is one fifth strength. The band sits on the edge and stays visible while the desktop is showing; a swipe in from it draws the wave over it.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Opacity</string>
			<key>key</key>
			<string>AreaAlpha</string>
			<key>default</key>
			<real>0.2</real>
			<key>min</key>
			<real>0.0</real>
			<key>max</key>
			<real>1.0</real>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Sensitivity</string>
			<key>footerText</key>
			<string>Minimum Travel is how far the finger must move inward before letting go opens the URL. Threshold is the travel at which the wave reaches full brightness.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Minimum Travel</string>
			<key>key</key>
			<string>MinimumTravel</string>
			<key>default</key>
			<integer>0</integer>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>60</integer>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Threshold</string>
			<key>key</key>
			<string>Threshold</string>
			<key>default</key>
			<integer>20</integer>
			<key>min</key>
			<integer>4</integer>
			<key>max</key>
			<integer>150</integer>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Animation</string>
			<key>footerText</key>
			<string>On shows the wave. Off draws the older triangle instead.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Animated Wave</string>
			<key>key</key>
			<string>Animated</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Haptic Feedback</string>
			<key>key</key>
			<string>Haptic</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>local.apelin.edgeurl</string>
			<key>PostNotification</key>
			<string>local.apelin.edgeurl/changed</string>
			<key>footerText</key>
			<string>A light tap of the Taptic Engine the moment a swipe commits and the URL opens.</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Restore Defaults</string>
			<key>footerText</key>
			<string>Puts every setting on this page back to the value a fresh install has.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Restore Defaults</string>
			<key>action</key>
			<string>restoreDefaults:</string>
			<key>alignment</key>
			<integer>1</integer>
		</dict>
	</array>
</dict>
</plist>
