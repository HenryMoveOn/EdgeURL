{
  "schemaVersion": 1,
  "projectID": "0eac5d13-7644-4c3d-a0b0-9f96506ffd62",
  "kind": "tweak",
  "template": {
    "extensionID": "wiki.qaq.apelin.dev.tweak",
    "templateID": "objc-hook",
    "version": "0.1.1",
    "digest": "sha256:f7aa0129fcb88ba57ea493d55f34828fd0bc1a435e5a0e3145dedf16118d4dc6"
  },
  "environment": {
    "toolchain": {
      "id": "c7b3bcbf6e4b457ebad6c3d4",
      "digest": "sha256:04f5b0e45cad0cb9b6c00e63e2e01064f1d48a91576a3c2a16a5c11182207cf2"
    },
    "sdk": {
      "id": "iphoneos27.0-d19c6254",
      "digest": "sha256:d19c6254debe3cce50810b8e4cb8e87c8053507423fc73f1501ab73476cf775e"
    }
  },
  "language": "objc",
  "deploymentTarget": "16.0",
  "architectures": {
    "rootless": [
      "arm64",
      "arm64e"
    ],
    "roothide": [
      "arm64e"
    ]
  },
  "configurations": {
    "Debug": {
      "optimization": "0",
      "debugInfo": true,
      "defines": {
        "DEBUG": "1"
      }
    },
    "Release": {
      "optimization": "2",
      "debugInfo": true
    }
  },
  "products": [
    {
      "id": "tweak",
      "type": "dylib",
      "name": "EdgeURL",
      "sources": [
        "Sources/*.m"
      ],
      "headerSearchPaths": [
        "Sources"
      ],
      "objcARC": true,
      "frameworks": [
        "Foundation",
        "UIKit",
        "QuartzCore",
        "CoreGraphics"
      ],
      "libraries": [
        "substrate"
      ],
      "extensionSupport": [
        {
          "extension": "wiki.qaq.apelin.dev.tweak",
          "component": "substrate"
        }
      ]
    },
    {
      "id": "prefs",
      "type": "bundle",
      "name": "EdgeURLPrefs",
      "sources": [
        "Prefs/*.m"
      ],
      "headerSearchPaths": [
        "Prefs"
      ],
      "resources": [
        "Resources/Root.plist",
        "Resources/icon.png",
        "Resources/icon@2x.png",
        "Resources/icon@3x.png"
      ],
      "infoPlist": "Resources/Info.plist",
      "objcARC": true,
      "frameworks": [
        "Foundation",
        "UIKit",
        "CoreGraphics",
        "Preferences"
      ],
      "extensionSupport": [
        {
          "extension": "wiki.qaq.apelin.dev.preferences",
          "component": "preferences"
        }
      ]
    }
  ],
  "build": {
    "steps": [
      {
        "type": "compile",
        "product": "tweak"
      },
      {
        "type": "link",
        "product": "tweak"
      },
      {
        "type": "lipo",
        "product": "tweak"
      },
      {
        "type": "dsym",
        "product": "tweak"
      },
      {
        "type": "strip",
        "product": "tweak",
        "style": "non-global"
      },
      {
        "type": "sign",
        "product": "tweak",
        "identity": "adhoc"
      },
      {
        "type": "compile",
        "product": "prefs"
      },
      {
        "type": "link",
        "product": "prefs"
      },
      {
        "type": "bundle-resources",
        "product": "prefs"
      },
      {
        "type": "lipo",
        "product": "prefs"
      },
      {
        "type": "dsym",
        "product": "prefs"
      },
      {
        "type": "strip",
        "product": "prefs",
        "style": "non-global"
      },
      {
        "type": "sign",
        "product": "prefs",
        "identity": "adhoc"
      }
    ]
  },
  "package": {
    "id": "local.apelin.edgeurl",
    "name": "EdgeURL",
    "version": "0.6.9",
    "description": "A translucent sensing bar sits on an edge over the desktop and every app: a swipe that starts inside it makes an Android-style wave follow your finger, then the URL opens. The rest is left alone.",
    "icon": "https://owngoal-dev.github.io/Apelin/icons/wiki.qaq.apelin.dev.tweak.png",
    "author": "moveon",
    "section": "Tweaks",
    "depends": [
      "mobilesubstrate",
      "preferenceloader"
    ],
    "layout": [
      {
        "path": "/Library/MobileSubstrate/DynamicLibraries/EdgeURL.dylib",
        "product": "tweak"
      },
      {
        "path": "/Library/PreferenceBundles/EdgeURLPrefs.bundle",
        "product": "prefs"
      },
      {
        "path": "/Library/PreferenceLoader/Preferences/EdgeURLPrefs.plist",
        "file": "Packaging/entry.plist",
        "mode": "0644"
      }
    ],
    "tweakFilter": {
      "dylib": "tweak",
      "bundles": [
        "com.apple.springboard"
      ]
    }
  }
}
